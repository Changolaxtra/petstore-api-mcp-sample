# For running `npm run start:dev` directly on the host against the
# Docker-Composed postgres/valkey services (published on localhost).
# Inside Docker, the root .env.example's service-name hosts are used instead.

DATABASE_URL=postgresql://petstore:petstore@localhost:5432/petstore
VALKEY_URL=redis://localhost:6379
API_KEY_TTL_SECONDS=1800
PORT=3000
