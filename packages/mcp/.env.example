# For running `npm run start:dev` directly on the host against the
# Docker-Composed `api` service (published on localhost).
# Inside Docker, the root .env.example's service-name host is used instead.

API_BASE_URL=http://localhost:3000

# Credentials this server uses to log in to the API itself (GET /user/login)
# and obtain the api_key header it attaches to its own outbound requests.
# Never exposed to the calling agent/end user. Must already exist as a user
# in the API (see packages/api's POST /user).
MCP_API_USERNAME=mcp-service
MCP_API_PASSWORD=change-me

# Port this MCP server listens on, inside and outside the container.
PORT=3001
