{
  "name": "@petstore/mcp",
  "private": true,
  "version": "0.1.0",
  "description": "LeanMCP server exposing the Petstore domain as MCP tools",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "tsc -p tsconfig.json --watch --preserveWatchOutput & node --watch dist/main.js",
    "lint": "eslint \"mcp/**/*.ts\" \"config/**/*.ts\" \"test/**/*.ts\" main.ts",
    "test": "jest --config test/jest.config.js",
    "codegen": "openapi-typescript ../api/swagger/openapi_pet_store.json -o mcp/http/types.generated.ts"
  },
  "dependencies": {
    "@leanmcp/core": "^0.4.7",
    "axios": "^1.21.1",
    "axios-retry": "^4.5.0",
    "reflect-metadata": "^0.2.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "axios-mock-adapter": "^2.1.0",
    "jest": "^29.7.0",
    "openapi-typescript": "^7.13.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2"
  }
}
