# Postgres (consumed directly by the postgres and liquibase Compose services)
POSTGRES_USER=petstore
POSTGRES_PASSWORD=petstore
POSTGRES_DB=petstore

# Derived connection string for application code (Kysely, etc.); host is the
# Compose service name (postgres) when running inside Docker, localhost otherwise.
DATABASE_URL=postgresql://petstore:petstore@postgres:5432/petstore

# Valkey (API-key session store); host is the Compose service name (valkey)
# when running inside Docker, localhost otherwise.
VALKEY_URL=redis://valkey:6379

# How long an issued API key stays valid, in seconds (FR-006; default 30 minutes).
API_KEY_TTL_SECONDS=1800

# Port the `api` service listens on, inside and outside the container.
PORT=3000
